<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown briefly while Flutter initializes; flutter_native_splash
         overwrites the drawable referenced here based on pubspec.yaml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Used after Flutter draws its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/tickbell_background</item>
    </style>
</resources>
